# syntax=docker/dockerfile:1
# CyberGym-E2E judge (task-server) for upstream task wavpack/arvo_20060 (generated by
# conversion/convert.py). Shared by this task's e2e and patch-only bundles.
# FROM the same base as the agent sandbox, so the judge sees exactly the tree the agent saw.
# The agent cannot reach this filesystem; it only sees the HTTP API, and every endpoint
# except /health needs the verifier token.
ARG BASE_IMAGE=cge2e_0d669ae695_base:v0.0.1
FROM ${BASE_IMAGE}

# Ground-truth PoC, at the path validate.py reads for stage 4.
COPY data/poc.bin /data/poc.bin

# /out and /work as prepare.sh left them. Upstream validates each stage in a fresh
# container; the judge restores these before every stage (validate.py restores /src).
RUN mkdir -p /opt/cge2e/snap /opt/cge2e/run \
 && for d in out work; do mkdir -p /$d && tar -C /$d -cf /opt/cge2e/snap/$d.tar .; done

COPY task_server.py /opt/cge2e/task_server.py

# Same token as docker-compose.yaml and tests/test.sh; baked in so the judge works even
# where the compose environment is not applied.
ENV AUTH_TOKEN=bb31d0ea74df4e317d58d4f9f1db7bbd
WORKDIR /
EXPOSE 9111
ENTRYPOINT []
CMD ["/scripts/.venv/bin/python", "-u", "/opt/cge2e/task_server.py"]
