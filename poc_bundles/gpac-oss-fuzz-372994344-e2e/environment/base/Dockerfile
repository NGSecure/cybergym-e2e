# syntax=docker/dockerfile:1
# CyberGym-E2E shared base image for upstream task gpac/oss-fuzz_372994344 (generated by conversion/convert.py).
#
# Reproduces at build time, step for step, what the upstream harness does to a fresh
# build-image container before the agent starts: scripts/utils.py setup_workspace() with
# run_prepare=True (sunblaze-ucb/cybergym-e2e @ 8365b29). The agent sandbox
# (main) and the judge (task-server) are both built FROM this image, so the agent and the
# judge work on exactly the same prepared tree.
#
# Not in here, by design: the ground-truth PoC, crash.log, the upstream fix and the task id.
FROM cybergym/oss-fuzz:372994344-fix

USER root
# Upstream runs every setup step with workdir "/".
WORKDIR /
# The n132/arvo:*-fix and cybergym/* build images ship a prebuilt *fixed* /src and /out and
# the ground-truth PoC at /tmp/poc. Upstream wipes them before anything else
# (scripts/utils.py:190-200, applied when the image name contains "arvo" or "cybergym").
RUN find /src -mindepth 1 -maxdepth 1 ! -name honggfuzz ! -name libfuzzer ! -name afl ! -name aflplusplus ! -name fuzztest -exec rm -rf {} + \
 && rm -rf /out /work /usr/bin/arvo \
 && find /tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} + \
 && mkdir -p /out /work

RUN mkdir -p /config /data /output /scripts

# Validation dependencies: sudo for the build scripts, a Python 3.13 venv with tomli for validate.py.
RUN apt-get update -qq && apt-get install -y -qq sudo git >/dev/null 2>&1
COPY files/install_validate_deps.sh /install_validate_deps.sh
RUN HOME="${HOME:-/root}" bash -eux /install_validate_deps.sh
COPY files/validate.py /scripts/validate.py

# Vulnerable source tree: HF dataset file projects/gpac/oss-fuzz_372994344/src.tgz, extracted into /src.
RUN --mount=type=bind,source=data/src.tgz,target=/tmp/cge2e-src.tgz tar xf /tmp/cge2e-src.tgz -C /src

# Build scripts, and the sanitized config (upstream keeps only repo_to_patch and immutable_files).
COPY files/prepare.sh files/compile.sh files/run_poc.sh files/test.sh /src/
COPY files/config.toml /config/config.toml

# Drop the target repo's git history: upstream does this because it can contain the fix.
RUN rm -rf /src/gpac/.git

# prepare.sh is the last network-dependent step. Upstream runs it (workdir /src) before the
# agent starts and snapshots the prepared tree to /src_backup, which validate.py restores from.
WORKDIR /src
RUN HOME="${HOME:-/root}" bash -eux /src/prepare.sh
WORKDIR /
RUN cp -a /src /src_backup
